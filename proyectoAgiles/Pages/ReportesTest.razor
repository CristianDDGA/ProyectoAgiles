@page "/admin/reportes-test"
@using ProyectoAgiles.Application.DTOs
@using proyectoAgiles.Services
@using Microsoft.AspNetCore.Components
@inject HttpClient Http
@inject NavigationManager Navigation
@inject UserSessionService UserSession
@layout proyectoAgiles.Layout.MainLayout

<PageTitle>Test Reportes - UTA</PageTitle>

<div class="container">
    <div class="row">
        <div class="col-12">
            <h1 class="mb-4">Test - Reportes de Ascensos Docentes</h1>
            
            @if (isLoading)
            {
                <div class="text-center">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <p>Cargando datos...</p>
                </div>
            }
            else if (errorMessage != null)
            {
                <div class="alert alert-danger">
                    <h4>Error al cargar datos</h4>
                    <p>@errorMessage</p>
                </div>
            }
            else
            {
                <div class="row mb-4">
                    <div class="col-md-3">
                        <div class="card bg-primary text-white">
                            <div class="card-body">
                                <h5 class="card-title">Total Solicitudes</h5>
                                <h2>@totalSolicitudes</h2>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card bg-success text-white">
                            <div class="card-body">
                                <h5 class="card-title">Aprobadas</h5>
                                <h2>@solicitudesAprobadas</h2>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card bg-warning text-white">
                            <div class="card-body">
                                <h5 class="card-title">Pendientes</h5>
                                <h2>@solicitudesPendientes</h2>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card bg-danger text-white">
                            <div class="card-body">
                                <h5 class="card-title">Rechazadas</h5>
                                <h2>@solicitudesRechazadas</h2>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <h5>Solicitudes de Escalafón</h5>
                    </div>
                    <div class="card-body">
                        @if (solicitudes.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>ID</th>
                                            <th>Docente</th>
                                            <th>Cédula</th>
                                            <th>Nivel Actual</th>
                                            <th>Nivel Solicitado</th>
                                            <th>Estado</th>
                                            <th>Fecha</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var solicitud in solicitudes.Take(10))
                                        {
                                            <tr>
                                                <td>@solicitud.Id</td>
                                                <td>@solicitud.DocenteNombre</td>
                                                <td>@solicitud.DocenteCedula</td>
                                                <td>@solicitud.NivelActual</td>
                                                <td>@solicitud.NivelSolicitado</td>
                                                <td>
                                                    <span class="badge bg-@(GetStatusColor(solicitud.Status))">
                                                        @solicitud.Status
                                                    </span>
                                                </td>
                                                <td>@solicitud.FechaSolicitud.ToString("dd/MM/yyyy")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info">
                                <p>No se encontraron solicitudes de escalafón.</p>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<SolicitudEscalafonDto> solicitudes = new();
    private bool isLoading = true;
    private string? errorMessage = null;
    
    // Propiedades calculadas
    private int totalSolicitudes => solicitudes.Count;
    private int solicitudesAprobadas => solicitudes.Count(s => s.Status == "Aprobada");
    private int solicitudesPendientes => solicitudes.Count(s => s.Status == "Pendiente");
    private int solicitudesRechazadas => solicitudes.Count(s => s.Status == "Rechazada");

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            
            // Intentar cargar datos directamente desde la API
            var response = await Http.GetFromJsonAsync<List<SolicitudEscalafonDto>>("/api/solicitudes-escalafon");
            
            if (response != null)
            {
                solicitudes = response;
                Console.WriteLine($"Solicitudes cargadas: {solicitudes.Count}");
            }
            else
            {
                errorMessage = "No se recibieron datos de la API";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar datos: {ex.Message}";
            Console.WriteLine($"Error: {ex}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private string GetStatusColor(string status)
    {
        return status switch
        {
            "Aprobada" => "success",
            "Rechazada" => "danger",
            "Pendiente" => "warning",
            _ => "secondary"
        };
    }
}
