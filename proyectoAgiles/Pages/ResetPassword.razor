@page "/reset-password"
@using proyectoAgiles.Services
@using System.ComponentModel.DataAnnotations
@inject AuthService AuthService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<PageTitle>Restablecer Contraseña - Sistema UTA</PageTitle>

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <h2>Restablecer Contraseña</h2>
            <p>Ingresa tu nueva contraseña</p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">
                @errorMessage
            </div>
        }

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success">
                @successMessage
            </div>
        }

        <form @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
            <div class="form-group">
                <label for="newPassword">Nueva Contraseña</label>
                <input type="password" 
                       id="newPassword" 
                       class="form-control @(HasValidationError(nameof(resetPasswordModel.NewPassword)) ? "is-invalid" : "")" 
                       @bind="resetPasswordModel.NewPassword" 
                       placeholder="Ingresa tu nueva contraseña"
                       required />
                <div class="invalid-feedback">
                    @GetValidationError(nameof(resetPasswordModel.NewPassword))
                </div>
            </div>

            <div class="form-group">
                <label for="confirmPassword">Confirmar Contraseña</label>
                <input type="password" 
                       id="confirmPassword" 
                       class="form-control @(HasValidationError(nameof(resetPasswordModel.ConfirmPassword)) ? "is-invalid" : "")" 
                       @bind="resetPasswordModel.ConfirmPassword" 
                       placeholder="Confirma tu nueva contraseña"
                       required />
                <div class="invalid-feedback">
                    @GetValidationError(nameof(resetPasswordModel.ConfirmPassword))
                </div>
            </div>

            <button type="submit" class="btn btn-primary btn-block" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span>Procesando...</span>
                }
                else
                {
                    <span>Actualizar Contraseña</span>
                }
            </button>
        </form>

        <div class="auth-footer">
            <p>¿Recordaste tu contraseña? <a href="/login">Iniciar Sesión</a></p>
        </div>
    </div>
</div>

@code {
    private ResetPasswordModel resetPasswordModel = new();
    private bool isLoading = false;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private Dictionary<string, string> validationErrors = new();

    [Parameter, SupplyParameterFromQuery]
    public string? Token { get; set; }

    [Parameter, SupplyParameterFromQuery]
    public string? Email { get; set; }

    protected override void OnInitialized()
    {
        // Verificar que tenemos los parámetros requeridos
        if (string.IsNullOrEmpty(Token) || string.IsNullOrEmpty(Email))
        {
            errorMessage = "El enlace de recuperación no es válido. Solicita uno nuevo.";
            return;
        }

        resetPasswordModel.Token = Token;
        resetPasswordModel.Email = Email;
    }

    private async Task HandleSubmit()
    {
        ClearMessages();
        
        if (!ValidateForm())
        {
            return;
        }

        isLoading = true;

        try
        {
            var response = await AuthService.ResetPasswordAsync(resetPasswordModel);

            if (response.Success)
            {
                successMessage = response.Message;
                
                // Redirigir al login después de unos segundos
                await Task.Delay(2000);
                Navigation.NavigateTo("/login", true);
            }
            else
            {
                errorMessage = response.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Error de conexión. Verifica tu conexión a internet e intenta nuevamente.";
            Console.WriteLine($"Error en reset password: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private bool ValidateForm()
    {
        validationErrors.Clear();

        if (string.IsNullOrWhiteSpace(resetPasswordModel.NewPassword))
        {
            validationErrors[nameof(resetPasswordModel.NewPassword)] = "La nueva contraseña es requerida";
        }
        else if (resetPasswordModel.NewPassword.Length < 6)
        {
            validationErrors[nameof(resetPasswordModel.NewPassword)] = "La contraseña debe tener al menos 6 caracteres";
        }

        if (string.IsNullOrWhiteSpace(resetPasswordModel.ConfirmPassword))
        {
            validationErrors[nameof(resetPasswordModel.ConfirmPassword)] = "Confirma tu nueva contraseña";
        }
        else if (resetPasswordModel.NewPassword != resetPasswordModel.ConfirmPassword)
        {
            validationErrors[nameof(resetPasswordModel.ConfirmPassword)] = "Las contraseñas no coinciden";
        }

        if (string.IsNullOrEmpty(resetPasswordModel.Token))
        {
            errorMessage = "Token de recuperación no válido";
        }

        if (string.IsNullOrEmpty(resetPasswordModel.Email))
        {
            errorMessage = "Email no válido";
        }

        return validationErrors.Count == 0 && string.IsNullOrEmpty(errorMessage);
    }

    private bool HasValidationError(string fieldName)
    {
        return validationErrors.ContainsKey(fieldName);
    }

    private string GetValidationError(string fieldName)
    {
        return validationErrors.GetValueOrDefault(fieldName, string.Empty);
    }

    private void ClearMessages()
    {
        errorMessage = string.Empty;
        successMessage = string.Empty;
        validationErrors.Clear();
    }
}
