
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.ComponentModel.DataAnnotations
@page "/register"
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<div class="auth-page">
    <!-- Fondo decorativo -->
    <div class="auth-background">
        <div class="bg-shape shape-1"></div>
        <div class="bg-shape shape-2"></div>
        <div class="bg-shape shape-3"></div>
        <div class="bg-shape shape-4"></div>
    </div>

    <!-- Botón de volver al inicio -->
    <a href="/" class="back-to-home-btn">
        <i class="fas fa-arrow-left"></i>
        Volver al Inicio
    </a>

    <div class="auth-container">
        <div class="auth-card">            <!-- Logo y títulos -->
            <div class="auth-logo">
                <img src="images/uta-logo.png" alt="Universidad Técnica de Ambato" class="logo-uta">
                <h1 class="auth-title">Crear Cuenta</h1>
                <p class="auth-subtitle">Universidad Técnica de Ambato</p>
            </div>

            <!-- Formulario de Registro -->
            <EditForm Model="@registerRequest" OnValidSubmit="@HandleRegistration" class="auth-form">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <label for="name" class="form-label">
                        <i class="fas fa-user"></i>
                        Nombre Completo
                    </label>
                    <InputText id="name" @bind-Value="registerRequest.Name" class="form-control" placeholder="Ingresa tu nombre completo" />
                    <ValidationMessage For="@(() => registerRequest.Name)" class="text-danger" />
                </div>

                <div class="form-group">
                    <label for="email" class="form-label">
                        <i class="fas fa-envelope"></i>
                        Correo Electrónico
                    </label>
                    <InputText id="email" @bind-Value="registerRequest.Email" class="form-control" placeholder="Ingresa tu correo electrónico" />
                    <ValidationMessage For="@(() => registerRequest.Email)" class="text-danger" />
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="password" class="form-label">
                            <i class="fas fa-lock"></i>
                            Contraseña
                        </label>
                        <InputText id="password" @bind-Value="registerRequest.Password" type="password" class="form-control" placeholder="Crea una contraseña segura" />
                        <ValidationMessage For="@(() => registerRequest.Password)" class="text-danger" />
                    </div>

                    <div class="form-group">
                        <label for="confirmPassword" class="form-label">
                            <i class="fas fa-lock"></i>
                            Confirmar Contraseña
                        </label>
                        <InputText id="confirmPassword" @bind-Value="registerRequest.ConfirmPassword" type="password" class="form-control" placeholder="Confirma tu contraseña" />
                        <ValidationMessage For="@(() => registerRequest.ConfirmPassword)" class="text-danger" />
                    </div>
                </div>

                <div class="form-group">
                    <label for="cedula" class="form-label">
                        <i class="fas fa-id-card"></i>
                        Cédula
                    </label>
                    <InputText id="cedula" @bind-Value="registerRequest.Cedula" class="form-control" placeholder="Ingresa tu número de cédula" />
                    <ValidationMessage For="@(() => registerRequest.Cedula)" class="text-danger" />
                </div>

                <!-- Zona de selección de archivos -->
                <div class="form-group">
                    <label class="form-label">
                        <i class="fas fa-file-upload"></i>
                        Documento de Identidad
                    </label>
                    <div class="file-drop-zone @(isDragOver ? "drag-over" : "")" 
                         @onclick="TriggerFileSelect">
                        
                        @if (selectedFile is null)
                        {
                            <div class="drop-zone-content">
                                <i class="fas fa-cloud-upload-alt"></i>
                                <div class="drop-zone-text">
                                    <p class="main-text">Haz clic para seleccionar tu documento</p>
                                    <small class="formats-text">Formatos soportados: PDF, JPG, PNG (Max. 10MB)</small>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="file-preview-container">
                                <div class="file-preview-header">
                                    <div class="file-info-preview">
                                        @if (isImageFile)
                                        {
                                            <i class="fas fa-image"></i>
                                        }
                                        else if (isPdfFile)
                                        {
                                            <i class="fas fa-file-pdf"></i>
                                        }
                                        else
                                        {
                                            <i class="fas fa-file"></i>
                                        }
                                        <div class="file-details">
                                            <span class="file-name">@selectedFile?.Name</span>
                                            <span class="file-size">@FormatFileSize(selectedFile?.Size ?? 0)</span>
                                        </div>
                                    </div>
                                    <button type="button" class="btn-remove-file" @onclick="ClearFile" @onclick:stopPropagation="true">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                                
                                @if (isImageFile && !string.IsNullOrEmpty(imagePreview))
                                {
                                    <div class="image-preview">
                                        <img src="@imagePreview" alt="Vista previa" class="preview-image" />
                                    </div>
                                }
                                else if (isPdfFile)
                                {
                                    <div class="pdf-preview">
                                        <i class="fas fa-file-pdf"></i>
                                        <span>@selectedFile?.Name</span>
                                        <small>@selectedFile?.ContentType</small>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    
                    <!-- Input file oculto -->
                    <InputFile @ref="fileInput" OnChange="HandleFileSelected" class="file-input-hidden" accept=".pdf,.jpg,.jpeg,.png,.gif,.bmp" />
                </div>                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger">
                        <i class="fas fa-exclamation-triangle"></i>
                        @errorMessage
                    </div>
                }

                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="alert alert-success">
                        <i class="fas fa-check-circle"></i>
                        @successMessage
                    </div>
                }

                <button type="submit" class="btn-register" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span>Registrando...</span>
                    }
                    else
                    {
                        <i class="fas fa-user-plus"></i>
                        <span>Crear Cuenta</span>
                    }
                </button>
            </EditForm>

            <!-- Enlaces adicionales -->
            <div class="auth-links">
                <p>¿Ya tienes una cuenta? <a href="/login" class="login-link">Inicia Sesión</a></p>
            </div>
        </div>
    </div>
</div>

@code {
    private RegisterRequest registerRequest = new();
    private InputFile? fileInput;
    private IBrowserFile? selectedFile;
    private bool isLoading = false;
    private bool isDragOver = false;
    private bool isImageFile = false;
    private bool isPdfFile = false;
    private string imagePreview = string.Empty;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    private async Task HandleRegistration()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;
            successMessage = string.Empty;

            // Procesar el archivo si existe
            if (selectedFile is not null)
            {
                using var stream = selectedFile.OpenReadStream(10 * 1024 * 1024); // Max 10MB
                using var memoryStream = new MemoryStream();
                await stream.CopyToAsync(memoryStream);
                registerRequest.DocumentFile = memoryStream.ToArray();
                registerRequest.DocumentFileName = selectedFile.Name;
                registerRequest.DocumentContentType = selectedFile.ContentType;
            }

            var result = await AuthService.RegisterAsync(registerRequest);
            
            if (result.IsSuccess)
            {
                successMessage = "¡Registro exitoso! Redirigiendo al login...";
                await Task.Delay(2000);
                Navigation.NavigateTo("/login");
            }
            else
            {
                errorMessage = result.ErrorMessage ?? "Error durante el registro";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        if (e.File != null)
        {
            await ProcessFile(e.File);
        }
    }

    private async Task ProcessFile(IBrowserFile file)
    {
        try
        {
            // Validar tamaño del archivo (10MB máximo)
            if (file.Size > 10 * 1024 * 1024)
            {
                errorMessage = "El archivo es demasiado grande. Tamaño máximo: 10MB";
                return;
            }

            // Validar tipo de archivo
            var allowedTypes = new[] { "application/pdf", "image/jpeg", "image/jpg", "image/png", "image/gif", "image/bmp" };
            if (!allowedTypes.Contains(file.ContentType.ToLower()))
            {
                errorMessage = "Tipo de archivo no válido. Solo se permiten: PDF, JPG, PNG, GIF, BMP";
                return;
            }

            selectedFile = file;
            isImageFile = file.ContentType.StartsWith("image/");
            isPdfFile = file.ContentType == "application/pdf";

            // Generar vista previa para imágenes
            if (isImageFile)
            {
                await GenerateImagePreview(file);
            }

            errorMessage = string.Empty;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al procesar el archivo: {ex.Message}";
        }
    }

    private async Task GenerateImagePreview(IBrowserFile file)
    {
        try
        {
            using var stream = file.OpenReadStream(10 * 1024 * 1024);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            var base64 = Convert.ToBase64String(memoryStream.ToArray());
            imagePreview = $"data:{file.ContentType};base64,{base64}";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al generar vista previa: {ex.Message}";
        }
    }

    private void TriggerFileSelect()
    {
        _ = JSRuntime.InvokeVoidAsync("triggerFileInput", fileInput?.Element);
    }

    private void ClearFile()
    {
        selectedFile = null;
        imagePreview = string.Empty;
        isImageFile = false;
        isPdfFile = false;
        errorMessage = string.Empty;
    }    private void HandleFileDrop(DragEventArgs e)
    {
        // Funcionalidad de drag and drop deshabilitada por compatibilidad
        // Solo usar el selector de archivos por click
    }

    private void HandleDragOver(DragEventArgs e)
    {
        // Funcionalidad deshabilitada
    }

    private void HandleDragEnter(DragEventArgs e)
    {
        // Funcionalidad deshabilitada
    }

    private void HandleDragLeave(DragEventArgs e)
    {
        // Funcionalidad deshabilitada
    }

    private string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024:F1} KB";
        return $"{bytes / (1024 * 1024):F1} MB";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("eval", @"
                window.triggerFileInput = (element) => {
                    if (element) {
                        element.click();
                    }
                };            ");
        }
    }
}
