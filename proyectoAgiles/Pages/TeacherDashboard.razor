                                        <div class="form-group">
                                            <label class="form-label">
                                                <i class="fas fa-calendar-alt label-icon"></i>
                                                Fecha de Publicación *
                                            </label>
                                            <input type="date" class="form-input" @bind="nuevaInvestigacion.FechaInicio" required />
                                        </div>
