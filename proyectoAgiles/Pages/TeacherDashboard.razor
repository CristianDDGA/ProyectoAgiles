    }    private async Task ImportarCapacitaciones()
    {
        isLoadingCapacitaciones = true;
        StateHasChanged();
        
        try
        {
            var cedula = UserSession.CurrentUser?.Cedula;
            if (string.IsNullOrEmpty(cedula))
            {
                await MostrarNotificacionError("❌ Error de importación", 
                    "No se pudo obtener la cédula del usuario.");
                return;
            }

            var apiBaseUrl = "http://localhost:5200";
            var url = $"{apiBaseUrl}/api/ditic/importar/{cedula}";

            var httpClient = new HttpClient();
            var response = await httpClient.PostAsync(url, null);

            if (response.IsSuccessStatusCode)
            {
                var content = await response.Content.ReadAsStringAsync();
                var result = System.Text.Json.JsonSerializer.Deserialize<ImportResult>(content);

                // Recargar capacitaciones después de la importación
                await CargarCapacitaciones();
                
                // Verificar si hay capacitaciones disponibles después de la importación
                if (capacitaciones.Any())
                {
                    if (result?.imported > 0)
                    {
                        await MostrarNotificacionExito($"✅ Importación exitosa", 
                            $"Se han importado {result.imported} nueva{(result.imported > 1 ? "s" : "")} capacitación{(result.imported > 1 ? "es" : "")}. Total disponible: {capacitaciones.Count}.");
                    }
                    else
                    {
                        await MostrarNotificacionExito($"✅ Capacitaciones cargadas", 
                            $"Se han cargado {capacitaciones.Count} capacitación{(capacitaciones.Count > 1 ? "es" : "")} desde la base de datos.");
                    }
                }
                else
                {
                    await MostrarNotificacionInfo("ℹ️ Sin resultados", 
                        "No se encontraron capacitaciones asociadas a tu cédula en la base de datos.");
                }
            }
            else
            {
                await MostrarNotificacionError("❌ Error de importación", 
                    "No se pudieron cargar las capacitaciones desde el sistema externo.");
            }
        }
        catch (Exception ex)
        {
            await MostrarNotificacionError("❌ Error de importación", 
                $"No se pudieron cargar las capacitaciones: {ex.Message}");
        }
        finally
        {
            isLoadingCapacitaciones = false;
            StateHasChanged();
        }
    }

    private async Task CargarCapacitaciones()
    {
        try
        {
            var cedula = UserSession.CurrentUser?.Cedula;
            if (string.IsNullOrEmpty(cedula))
                return;

            var apiBaseUrl = "http://localhost:5200";
            var url = $"{apiBaseUrl}/api/ditic/docente/{cedula}";

            var httpClient = new HttpClient();
            var response = await httpClient.GetAsync(url);

            if (response.IsSuccessStatusCode)
            {
                var jsonContent = await response.Content.ReadAsStringAsync();
                var apiCapacitaciones = System.Text.Json.JsonSerializer.Deserialize<DiticDto[]>(jsonContent, 
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true });

                if (apiCapacitaciones != null)
                {
                    capacitaciones = apiCapacitaciones.ToList();
                    StateHasChanged();
                }
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error al cargar capacitaciones: {ex.Message}");
        }
    }

