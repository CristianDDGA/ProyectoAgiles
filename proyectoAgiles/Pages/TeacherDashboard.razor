                    // Agregar archivo PDF
                    var pdfStream = selectedEvaluacionPdf.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024); // 10MB max
                    var pdfContent = new StreamContent(pdfStream);
                    pdfContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("application/pdf");
                    content.Add(pdfContent, "ArchivoPdf", selectedEvaluacionPdf.Name);

                    var response = await httpClient.PostAsync($"{apiBaseUrl}/api/evaluacionesdesempeno/with-pdf", content);

                    if (response.IsSuccessStatusCode)
                    {
                        await MostrarNotificacionExito("Evaluación creada", "La evaluación se ha creado correctamente con su archivo PDF.");
                        
                        // Recargar evaluaciones
                        await ImportarEvaluaciones();
                        CloseAgregarEvaluacionModal();
                    }
                    else
                    {
                        var errorContent = await response.Content.ReadAsStringAsync();
                        await MostrarNotificacionError("Error al crear evaluación", $"No se pudo crear la evaluación: {errorContent}");
                    }
                }
                else
                {
                    // Crear sin archivo PDF
                    var createDto = new CreateEvaluacionDesempenoDto
                    {
                        Cedula = nuevaEvaluacion.Cedula,
                        PeriodoAcademico = nuevaEvaluacion.PeriodoAcademico,
                        Anio = nuevaEvaluacion.Anio,
                        Semestre = nuevaEvaluacion.Semestre,
                        PuntajeObtenido = nuevaEvaluacion.PuntajeObtenido,
                        PuntajeMaximo = nuevaEvaluacion.PuntajeMaximo,
                        FechaEvaluacion = nuevaEvaluacion.FechaEvaluacion,
                        TipoEvaluacion = nuevaEvaluacion.TipoEvaluacion,
                        Observaciones = nuevaEvaluacion.Observaciones,
                        Estado = nuevaEvaluacion.Estado,
                        Evaluador = nuevaEvaluacion.Evaluador
                    };

                    var json = System.Text.Json.JsonSerializer.Serialize(createDto);
                    var stringContent = new StringContent(json, System.Text.Encoding.UTF8, "application/json");

                    var response = await httpClient.PostAsync($"{apiBaseUrl}/api/evaluacionesdesempeno", stringContent);

                    if (response.IsSuccessStatusCode)
                    {
                        await MostrarNotificacionExito("Evaluación creada", "La evaluación se ha creado correctamente.");
                        
                        // Recargar evaluaciones
                        await ImportarEvaluaciones();
                        CloseAgregarEvaluacionModal();
                    }
                    else
                    {
                        var errorContent = await response.Content.ReadAsStringAsync();
                        await MostrarNotificacionError("Error al crear evaluación", $"No se pudo crear la evaluación: {errorContent}");
                    }
                }
            }
        }
        catch (Exception ex)
        {
            await MostrarNotificacionError("Error inesperado", $"Ocurrió un error: {ex.Message}");
        }
        finally
        {
            isSavingEvaluacion = false;
            StateHasChanged();
        }
    }

