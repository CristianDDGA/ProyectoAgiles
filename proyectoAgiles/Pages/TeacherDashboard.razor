    // Métodos auxiliares para generar resúmenes detallados de la solicitud
    private int ObtenerAnosExperiencia(EstadisticasDocenteResponse? estadisticas)
    {
        if (estadisticas?.Secciones?.Experiencia?.Datos != null)
        {
            var datosExperiencia = estadisticas.Secciones.Experiencia.Datos;
            return (int)Math.Round(datosExperiencia.AñosObtenidos);
        }

        // Como último recurso, retornar 0
        return 0;
    }

    private string GenerarResumenPublicaciones(EstadisticasDocenteResponse? estadisticas)
    {
        if (estadisticas?.Secciones?.Obras?.Datos == null)
            return "Sin publicaciones registradas";

        var datos = estadisticas.Secciones.Obras.Datos;
        var totalObras = datos.TotalObras;
        var obrasConUTA = datos.ObrasConUTA;

        if (totalObras == 0)
            return "Sin publicaciones registradas";

        return $"Total: {totalObras} obra(s) registrada(s). Con filiación UTA: {obrasConUTA} obra(s).";
    }

    private string GenerarResumenProyectos(EstadisticasDocenteResponse? estadisticas)
    {
        if (estadisticas?.Secciones?.Obras?.Datos == null)
            return "Sin proyectos de investigación registrados";

        var datos = estadisticas.Secciones.Obras.Datos;
        var obrasConUTA = datos.ObrasConUTA;

        if (obrasConUTA == 0)
            return "Sin proyectos de investigación con filiación UTA registrados";

        return $"Proyectos con filiación UTA: {obrasConUTA} proyecto(s) registrado(s).";
    }

    private string GenerarResumenCapacitaciones(EstadisticasDocenteResponse? estadisticas)
    {
        if (estadisticas?.Secciones?.Capacitaciones?.Datos == null)
            return "Sin capacitaciones registradas";

        var datos = estadisticas.Secciones.Capacitaciones.Datos;
        var horasObtenidas = datos.HorasObtenidas;
        var horasPedagogicas = datos.HorasPedagogicasObtenidas;

        if (horasObtenidas == 0)
            return "Sin capacitaciones registradas";

        return $"Total: {horasObtenidas} horas de capacitación. Horas pedagógicas: {horasPedagogicas} horas.";
    }

