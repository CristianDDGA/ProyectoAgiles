                                            <th><i class="fas fa-percentage me-2"></i>Porcentaje</th>
                                            <th><i class="fas fa-check-circle me-2"></i>Estado</th>
                                            <th><i class="fas fa-clock me-2"></i>Fecha Eval.</th>
