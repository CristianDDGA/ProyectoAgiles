                                                        <i class="fas @(cumpleObrasUTA ? "fa-check" : "fa-times")"></i>
                                                    </span>
                                                    <strong>@(cumpleObrasUTA ? "CUMPLE" : "NO CUMPLE")</strong>
                                                </div>
