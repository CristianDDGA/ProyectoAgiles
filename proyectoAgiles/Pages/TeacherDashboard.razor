                                            <th><i class="fas fa-university me-2"></i>Institución</th>
                                            <th><i class="fas fa-tag me-2"></i>Tipo</th>
                                            <th><i class="fas fa-laptop me-2"></i>Modalidad</th>
                                            <th><i class="fas fa-clock me-2"></i>Horas</th>
