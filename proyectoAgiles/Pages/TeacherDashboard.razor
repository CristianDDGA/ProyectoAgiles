@page "/docente"
@using Microsoft.AspNetCore.Components.Web
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using proyectoAgiles.Services
@layout proyectoAgiles.Layout.MainLayout
@inject NavigationManager Navigation
@inject proyectoAgiles.Services.AuthService AuthService
@inject UserSessionService UserSession
@inject IJSRuntime JSRuntime

<PageTitle>Panel de Docente - UTA</PageTitle>

<div class="teacher-dashboard">    <!-- Sección de Nivel -->
    <div class="nivel-section-container mb-4">
        <div class="nivel-card">
            <div class="nivel-content-horizontal">
                <div class="nivel-title-section">
                    <h5 class="nivel-title">
                        <i class="fas fa-graduation-cap"></i>
                        Nivel Académico Actual
                    </h5>
                </div>
                  <div class="nivel-current-info">
                    <div class="nivel-badge-container">
                        <span class="badge bg-info text-dark nivel-badge">@UserSession.GetUserNivel()</span>
                    </div>
                </div>
                
                <div class="nivel-actions">
                    <button class="btn btn-success nivel-btn" @onclick="ShowRequisitosModal">
                        <i class="fas fa-arrow-up me-2"></i>
                        Subir de Nivel
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (showRequisitosModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.3);">
            <div class="modal-dialog modal-xl">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <i class="fas fa-level-up-alt me-2"></i>
                            Requisitos para subir de nivel - Titular Auxiliar 2
                        </h5>
                        <button type="button" class="btn-close" @onclick="CloseRequisitosModal"></button>
                    </div>
                    <div class="modal-body">
                        @if (isLoadingRequisitos)
                        {
                            <div class="text-center py-4">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Verificando requisitos...</span>
                                </div>
                                <p class="mt-3">Verificando requisitos...</p>
                            </div>
                        }
                        else if (requisitosVerificacion != null)
                        {
                            <!-- Resultado de verificación -->
                            <div class="alert @(requisitosVerificacion.CumpleTodosRequisitos ? "alert-success" : "alert-warning") mb-4">                                <h6 class="alert-heading mb-2">
                                    @if (requisitosVerificacion.CumpleTodosRequisitos)
                                    {
                                        <i class="fas fa-check-circle me-2"></i>@("¡FELICIDADES!")
                                    }
                                    else
                                    {
                                        <i class="fas fa-exclamation-triangle me-2"></i>@("REQUISITOS PENDIENTES")
                                    }
                                </h6>
                                <p class="mb-0">@requisitosVerificacion.Mensaje</p>
                                <small class="text-muted">Verificación realizada el: @requisitosVerificacion.FechaVerificacion.ToString("dd/MM/yyyy HH:mm")</small>
                            </div>

                            <!-- Detalles de cada requisito -->
                            <div class="row">
                                <div class="col-12">
                                    <div class="card mb-3">
                                        <div class="card-header d-flex align-items-center">
                                            @if (requisitosVerificacion.Experiencia.Cumple)
                                            {
                                                <i class="fas fa-check-circle text-success me-2"></i>
                                            }
                                            else
                                            {
                                                <i class="fas fa-times-circle text-danger me-2"></i>
                                            }
                                            <strong>1. Experiencia Mínima (4 años)</strong>
                                        </div>
                                        <div class="card-body">
                                            <p class="mb-2">@requisitosVerificacion.Experiencia.Mensaje</p>
                                            <div class="row">
                                                <div class="col-sm-6">
                                                    <small class="text-muted">Valor obtenido:</small>
                                                    <div>@requisitosVerificacion.Experiencia.ValorObtenido</div>
                                                </div>
                                                <div class="col-sm-6">
                                                    <small class="text-muted">Requerido:</small>
                                                    <div>@requisitosVerificacion.Experiencia.ValorRequerido</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="card mb-3">
                                        <div class="card-header d-flex align-items-center">
                                            @if (requisitosVerificacion.ObraRelevante.Cumple)
                                            {
                                                <i class="fas fa-check-circle text-success me-2"></i>
                                            }
                                            else
                                            {
                                                <i class="fas fa-times-circle text-danger me-2"></i>
                                            }
                                            <strong>2. Obra Relevante/Artículo Indexado (Filiación UTA)</strong>
                                        </div>
                                        <div class="card-body">
                                            <p class="mb-2">@requisitosVerificacion.ObraRelevante.Mensaje</p>
                                            <div class="row">
                                                <div class="col-sm-6">
                                                    <small class="text-muted">Valor obtenido:</small>
                                                    <div>@requisitosVerificacion.ObraRelevante.ValorObtenido</div>
                                                </div>
                                                <div class="col-sm-6">
                                                    <small class="text-muted">Requerido:</small>
                                                    <div>@requisitosVerificacion.ObraRelevante.ValorRequerido</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="card mb-3">
                                        <div class="card-header d-flex align-items-center">
                                            @if (requisitosVerificacion.Evaluacion75Porciento.Cumple)
                                            {
                                                <i class="fas fa-check-circle text-success me-2"></i>
                                            }
                                            else
                                            {
                                                <i class="fas fa-times-circle text-danger me-2"></i>
                                            }
                                            <strong>3. Evaluación 75% (Últimos 4 períodos)</strong>
                                        </div>
                                        <div class="card-body">
                                            <p class="mb-2">@requisitosVerificacion.Evaluacion75Porciento.Mensaje</p>
                                            <div class="row">
                                                <div class="col-sm-6">
                                                    <small class="text-muted">Valor obtenido:</small>
                                                    <div>@requisitosVerificacion.Evaluacion75Porciento.ValorObtenido</div>
                                                </div>
                                                <div class="col-sm-6">
                                                    <small class="text-muted">Requerido:</small>
                                                    <div>@requisitosVerificacion.Evaluacion75Porciento.ValorRequerido</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="card mb-3">
                                        <div class="card-header d-flex align-items-center">
                                            @if (requisitosVerificacion.Capacitacion96Horas.Cumple)
                                            {
                                                <i class="fas fa-check-circle text-success me-2"></i>
                                            }
                                            else
                                            {
                                                <i class="fas fa-times-circle text-danger me-2"></i>
                                            }
                                            <strong>4. Capacitación 96 horas (24h pedagógicas)</strong>
                                        </div>
                                        <div class="card-body">
                                            <p class="mb-2">@requisitosVerificacion.Capacitacion96Horas.Mensaje</p>
                                            <div class="row">
                                                <div class="col-sm-6">
                                                    <small class="text-muted">Valor obtenido:</small>
                                                    <div>@requisitosVerificacion.Capacitacion96Horas.ValorObtenido</div>
                                                </div>
                                                <div class="col-sm-6">
                                                    <small class="text-muted">Requerido:</small>
                                                    <div>@requisitosVerificacion.Capacitacion96Horas.ValorRequerido</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <!-- Lista inicial de requisitos -->
                            <div class="alert alert-info mb-4">
                                <h6 class="alert-heading">Requisitos para ascender a Titular Auxiliar 2</h6>
                                <p class="mb-0">Haz clic en "Verificar requisitos" para comprobar si cumples con todos los requisitos necesarios.</p>
                            </div>

                            <div class="accordion" id="requisitosAccordion">
                                <div class="accordion-item">
                                    <h2 class="accordion-header" id="headingOne">
                                        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne">
                                            <strong>1. Experiencia mínima de 4 años</strong>
                                        </button>
                                    </h2>
                                    <div id="collapseOne" class="accordion-collapse collapse show" data-bs-parent="#requisitosAccordion">
                                        <div class="accordion-body">
                                            Experiencia mínima de 4 años como personal académico titular auxiliar 1 en la práctica docente en la Universidad Técnica de Ambato.
                                        </div>
                                    </div>
                                </div>

                                <div class="accordion-item">
                                    <h2 class="accordion-header" id="headingTwo">
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo">
                                            <strong>2. Obra relevante o artículo indexado</strong>
                                        </button>
                                    </h2>
                                    <div id="collapseTwo" class="accordion-collapse collapse" data-bs-parent="#requisitosAccordion">
                                        <div class="accordion-body">
                                            Haber creado o publicado una obra de relevancia o un artículo indexado, con filiación UTA, en el campo amplio de conocimiento vinculado a sus actividades de docencia o investigación. La publicación deberá ser realizada durante el ejercicio de sus actividades en el grado que se encuentra.
                                        </div>
                                    </div>
                                </div>

                                <div class="accordion-item">
                                    <h2 class="accordion-header" id="headingThree">
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree">
                                            <strong>3. Evaluación 75% mínimo</strong>
                                        </button>
                                    </h2>
                                    <div id="collapseThree" class="accordion-collapse collapse" data-bs-parent="#requisitosAccordion">
                                        <div class="accordion-body">
                                            Haber obtenido como mínimo el setenta y cinco por ciento (75 %) del puntaje de la evaluación integral en los últimos cuatro periodos académicos de evaluación de desempeño en los que ejerció la docencia.
                                        </div>
                                    </div>
                                </div>

                                <div class="accordion-item">
                                    <h2 class="accordion-header" id="headingFour">
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFour">
                                            <strong>4. Capacitación 96 horas</strong>
                                        </button>
                                    </h2>
                                    <div id="collapseFour" class="accordion-collapse collapse" data-bs-parent="#requisitosAccordion">
                                        <div class="accordion-body">
                                            Haber realizado y aprobado noventa y seis horas de capacitación y actualización profesional y científica en los últimos tres (3) años en una Universidad o Escuela Politécnica acreditada. Al menos 24 Horas (25%) de estas deberán ser de actualización pedagógica. 
                                            <br><br>
                                            <strong>Excepción:</strong> El cumplimiento de este literal se exceptúa si se ha desempeñado como autoridad en una Universidad o Escuela Politécnica por más de dos (2) años.
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="modal-footer">
                        @if (requisitosVerificacion == null)
                        {
                            <button class="btn btn-primary" @onclick="VerificarRequisitos" disabled="@isLoadingRequisitos">
                                @if (isLoadingRequisitos)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                <i class="fas fa-search me-1"></i>
                                Verificar requisitos
                            </button>
                        }
                        else if (requisitosVerificacion.CumpleTodosRequisitos)
                        {
                            <button class="btn btn-success me-2" @onclick="SubirNivel">
                                <i class="fas fa-arrow-up me-1"></i>
                                Subir de nivel
                            </button>
                            <button class="btn btn-outline-primary" @onclick="VerificarRequisitos">
                                <i class="fas fa-refresh me-1"></i>
                                Verificar nuevamente
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-outline-primary" @onclick="VerificarRequisitos">
                                <i class="fas fa-refresh me-1"></i>
                                Verificar nuevamente
                            </button>
                        }                        <button class="btn btn-secondary" @onclick="CloseRequisitosModal">Cerrar</button>
                    </div>
                </div>
            </div>
        </div>    }

    @if (showInvestigacionesModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.3);">
            <div class="modal-dialog modal-xl">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Gestión de Investigaciones</h5>
                        <button type="button" class="btn-close" @onclick="CloseInvestigacionesModal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="d-flex justify-content-between mb-3">
                            <h6>Mis Investigaciones</h6>
                            <div>
                                <button class="btn btn-success me-2" @onclick="ShowAgregarInvestigacion">
                                    <i class="fas fa-plus"></i> Agregar
                                </button>
                                <button class="btn btn-primary" @onclick="ImportarInvestigaciones">
                                    <i class="fas fa-download"></i> Importar
                                </button>
                            </div>
                        </div>
                          @if (isLoadingInvestigaciones)
                        {
                            <div class="text-center">
                                <div class="spinner-border" role="status">
                                    <span class="visually-hidden">Cargando...</span>
                                </div>
                                <p class="mt-2">Cargando investigaciones...</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Título</th>
                                            <th>Área</th>
                                            <th>Tipo</th>
                                            <th>Estado</th>
                                            <th>Fecha Publicación</th>
                                            <th>Revista/Editorial</th>
                                            <th>Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (investigaciones.Any())
                                        {
                                            @foreach (var investigacion in investigaciones)
                                            {
                                                <tr>
                                                    <td>@investigacion.Titulo</td>
                                                    <td>@investigacion.Area</td>
                                                    <td>@investigacion.Tipo</td>
                                                    <td>
                                                        <span class="badge @GetEstadoBadgeClass(investigacion.Estado)">
                                                            @investigacion.Estado
                                                        </span>
                                                    </td>
                                                    <td>@investigacion.FechaInicio.ToString("dd/MM/yyyy")</td>
                                                    <td>@investigacion.RevistaOEditorial</td>
                                                    <td>
                                                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditarInvestigacion(investigacion)">
                                                            <i class="fas fa-edit"></i>
                                                        </button>
                                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => EliminarInvestigacion(investigacion.Id)">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                        @if (investigacion.TienePdf)
                                                        {
                                                            <button class="btn btn-outline-primary btn-sm" @onclick="() => VerPdf(investigacion.Id)">
                                                                <i class="fas fa-file-pdf"></i> Ver PDF
                                                            </button>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        }                                        else
                                        {
                                            <tr>
                                                <td colspan="7" class="text-center text-muted py-4">
                                                    <i class="fas fa-search fa-2x mb-2"></i>
                                                    <p class="mb-1">No hay investigaciones cargadas</p>
                                                    <small>Haz clic en "Importar" para cargar tus investigaciones desde la base de datos</small>
                                                    <br><small class="text-info">Cédula actual: @(UserSession.CurrentUser?.Cedula ?? "No disponible")</small>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="CloseInvestigacionesModal">Cerrar</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (showAgregarModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.3);">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">@(editingInvestigacion != null ? "Editar" : "Agregar") Investigación</h5>
                        <button type="button" class="btn-close" @onclick="CloseAgregarModal"></button>
                    </div>
                    <div class="modal-body">                        <form>
                            <div class="row">
                                <div class="col-md-12 mb-3">
                                    <label class="form-label">Título *</label>
                                    <input type="text" class="form-control" @bind="nuevaInvestigacion.Titulo" required />
                                </div>
                                <div class="col-md-12 mb-3">
                                    <label class="form-label">Área de Conocimiento *</label>
                                    <input type="text" class="form-control" @bind="nuevaInvestigacion.Area" required />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Fecha de Publicación *</label>
                                    <input type="date" class="form-control" @bind="nuevaInvestigacion.FechaInicio" required />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Revista/Editorial</label>
                                    <input type="text" class="form-control" @bind="nuevaInvestigacion.RevistaOEditorial" placeholder="Nombre de la revista o editorial" />
                                </div>
                                <div class="col-md-12 mb-3">
                                    <label class="form-label">Observaciones</label>
                                    <textarea class="form-control" rows="3" @bind="nuevaInvestigacion.Descripcion" placeholder="Descripción o comentarios adicionales sobre la investigación"></textarea>
                                </div>
                                <div class="col-md-12 mb-3">
                                    <label class="form-label">Archivo PDF</label>
                                    <InputFile OnChange="HandlePdfSelected" accept=".pdf" />
                                    @if (!string.IsNullOrEmpty(pdfFileName))
                                    {
                                        <div class="mt-2 text-success">
                                            <i class="fas fa-file-pdf"></i> @pdfFileName
                                        </div>
                                    }
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-success" @onclick="GuardarInvestigacion" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            }
                            @(editingInvestigacion != null ? "Actualizar" : "Guardar")
                        </button>
                        <button class="btn btn-secondary" @onclick="CloseAgregarModal">Cancelar</button>
                    </div>
                </div>
            </div>        </div>
    }

    @* Modal para Evaluaciones de Desempeño *@
    @if (showEvaluacionesModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.3);">
            <div class="modal-dialog modal-xl">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Gestión de Evaluaciones de Desempeño DAC</h5>
                        <button type="button" class="btn-close" @onclick="CloseEvaluacionesModal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="d-flex justify-content-between mb-3">
                            <h6>Mis Evaluaciones DAC</h6>
                            <div>
                                <button class="btn btn-success me-2" @onclick="ShowAgregarEvaluacion">
                                    <i class="fas fa-plus"></i> Agregar
                                </button>
                                <button class="btn btn-primary" @onclick="ImportarEvaluaciones">
                                    <i class="fas fa-download"></i> Importar
                                </button>
                            </div>
                        </div>
                          @if (isLoadingEvaluaciones)
                        {
                            <div class="text-center">
                                <div class="spinner-border" role="status">
                                    <span class="visually-hidden">Cargando...</span>
                                </div>
                                <p class="mt-2">Cargando evaluaciones...</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Período</th>
                                            <th>Año</th>
                                            <th>Semestre</th>
                                            <th>Puntaje</th>
                                            <th>Porcentaje</th>
                                            <th>Estado</th>
                                            <th>Fecha Evaluación</th>
                                            <th>Evaluador</th>
                                            <th>Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (evaluaciones.Any())
                                        {
                                            @foreach (var evaluacion in evaluaciones)
                                            {
                                                <tr>
                                                    <td>@evaluacion.PeriodoAcademico</td>
                                                    <td>@evaluacion.Anio</td>
                                                    <td>@evaluacion.Semestre</td>
                                                    <td>@evaluacion.PuntajeObtenido/@evaluacion.PuntajeMaximo</td>
                                                    <td>
                                                        <span class="badge @GetPorcentajeBadgeClass(evaluacion.PorcentajeObtenido)">
                                                            @evaluacion.PorcentajeObtenido.ToString("F1")%
                                                        </span>
                                                    </td>
                                                    <td>@evaluacion.Estado</td>
                                                    <td>@evaluacion.FechaEvaluacion.ToString("dd/MM/yyyy")</td>
                                                    <td>@evaluacion.Evaluador</td>
                                                    <td>
                                                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditarEvaluacion(evaluacion)">
                                                            <i class="fas fa-edit"></i>
                                                        </button>
                                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => EliminarEvaluacion(evaluacion.Id)">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                        @if (!string.IsNullOrEmpty(evaluacion.NombreArchivoRespaldo))
                                                        {
                                                            <button class="btn btn-outline-primary btn-sm" @onclick="() => VerPdfEvaluacion(evaluacion.Id)">
                                                                <i class="fas fa-file-pdf"></i> Ver PDF
                                                            </button>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="9" class="text-center text-muted py-4">
                                                    <i class="fas fa-star fa-2x mb-2"></i>
                                                    <p class="mb-1">No hay evaluaciones de desempeño cargadas</p>
                                                    <small>Haz clic en "Importar" para cargar tus evaluaciones desde la base de datos DAC</small>
                                                    <br><small class="text-info">Cédula actual: @(UserSession.CurrentUser?.Cedula ?? "No disponible")</small>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            
                            @* Mostrar resumen de cumplimiento del 75% *@
                            @if (evaluaciones.Any())
                            {
                                <div class="mt-4">
                                    <div class="card">
                                        <div class="card-header">
                                            <h6 class="card-title mb-0">
                                                <i class="fas fa-chart-line"></i> Verificación Requisito 75%
                                            </h6>
                                        </div>
                                        <div class="card-body">
                                            @if (verificacionRequisito != null)
                                            {
                                                <div class="row">
                                                    <div class="col-md-6">
                                                        <div class="d-flex align-items-center">
                                                            <span class="badge @(verificacionRequisito.CumpleRequisito ? "bg-success" : "bg-danger") me-2">
                                                                <i class="fas @(verificacionRequisito.CumpleRequisito ? "fa-check" : "fa-times")"></i>
                                                            </span>
                                                            <strong>@(verificacionRequisito.CumpleRequisito ? "CUMPLE" : "NO CUMPLE")</strong>
                                                        </div>
