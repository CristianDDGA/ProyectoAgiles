                                                    <div class="col-md-6">
                                                        <p class="mb-1"><strong>Evaluaciones analizadas:</strong> @verificacionRequisito.EvaluacionesAnalizadas</p>
                                                        <p class="mb-1"><strong>Que alcanzan 75%:</strong> @verificacionRequisito.EvaluacionesQueAlcanzan75</p>
                                                        <p class="mb-0"><strong>Promedio últimas 4:</strong> @verificacionRequisito.PorcentajePromedioUltimasCuatro%</p>
                                                    </div>
                                                </div>
