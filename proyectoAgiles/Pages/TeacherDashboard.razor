                                                    </td>
                                                    <td class="text-center">
                                                        <span class="table-badge secondary">@evaluacion.Semestre</span>
                                                    </td>
                                                    <td class="col-score">
                                                        <div class="fw-bold">@evaluacion.PuntajeObtenido</div>
                                                        <small class="text-muted">/ @evaluacion.PuntajeMaximo</small>
                                                    </td>
                                                    <td class="col-score">
