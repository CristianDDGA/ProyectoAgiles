@page "/login"
@using Microsoft.AspNetCore.Components.Web
@using proyectoAgiles.Services
@layout proyectoAgiles.Layout.AuthLayout
@inject AuthService AuthService
@inject NavigationManager NavigationManager

<PageTitle>Iniciar Sesión - UTA</PageTitle>

<div class="auth-page">
    <!-- Botón de volver al inicio -->
    <a href="/" class="back-to-home-btn">
        <i class="fas fa-arrow-left"></i>
        Volver al inicio
    </a>
    
    <div class="auth-container">
        <div class="auth-card">
            <!-- Logo UTA -->
            <div class="auth-logo">
                <img src="images/uta-logo.png" alt="Universidad Técnica de Ambato" class="logo-uta">
                <h2 class="auth-title">Iniciar Sesión</h2>
                <p class="auth-subtitle">Universidad Técnica de Ambato</p>
            </div>            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="@GetAlertClass()">
                    <i class="@GetAlertIcon()"></i>
                    
                    @if (isAccountLocked)
                    {
                        <div class="account-locked-message">
                            @foreach (var line in errorMessage.Split('\n', StringSplitOptions.RemoveEmptyEntries))
                            {
                                <div class="message-line">@line</div>
                            }
                            <div class="unlock-action mt-3">
                                <a href="/forgot-password" class="btn btn-outline-primary btn-sm">
                                    <i class="fas fa-key"></i>
                                    Restablecer mi Contraseña
                                </a>
                            </div>
                        </div>
                    }
                    else
                    {
                        @errorMessage
                    }
                </div>
            }

            <!-- Formulario de Login -->
            <EditForm Model="loginRequest" OnValidSubmit="HandleLogin" class="auth-form">
                <DataAnnotationsValidator />
                
                <div class="form-group">
                    <label for="email" class="form-label">
                        <i class="fas fa-envelope"></i>
                        Correo Electrónico
                    </label>
                    <InputText id="email" class="form-control" placeholder="Ingresa tu correo electrónico" 
                               @bind-Value="loginRequest.Email" />
                    <ValidationMessage For="@(() => loginRequest.Email)" class="text-danger" />
                </div>

                <div class="form-group">
                    <label for="password" class="form-label">
                        <i class="fas fa-lock"></i>
                        Contraseña
                    </label>
                    <InputText type="password" id="password" class="form-control" placeholder="Ingresa tu contraseña" 
                               @bind-Value="loginRequest.Password" />
                    <ValidationMessage For="@(() => loginRequest.Password)" class="text-danger" />
                </div>

                <div class="form-options">
                    <div class="form-check">
                        <input type="checkbox" id="remember" class="form-check-input">
                        <label for="remember" class="form-check-label">
                            Recordarme
                        </label>
                    </div>
                    <a href="/forgot-password" class="forgot-password">¿Olvidaste tu contraseña?</a>
                </div>

                <button type="submit" class="btn btn-primary btn-login" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm mr-2" role="status" aria-hidden="true"></span>
                        <span>Procesando...</span>
                    }
                    else
                    {
                        <i class="fas fa-sign-in-alt"></i>
                        <span>Iniciar Sesión</span>
                    }
                </button>
            </EditForm>            <!-- Enlaces adicionales -->
            <div class="auth-links">
                <p>¿No tienes una cuenta? <a href="/register" class="register-link">Regístrate aquí</a></p>
            </div>
        </div>
    </div>
    
    <!-- Background decorativo -->
    <div class="auth-background">
        <div class="bg-shape shape-1"></div>
        <div class="bg-shape shape-2"></div>
        <div class="bg-shape shape-3"></div>
    </div>
</div>

@code {
    private LoginRequest loginRequest = new();
    private bool isLoading = false;
    private string errorMessage = string.Empty;
    private bool isAccountLocked = false;

    private async Task HandleLogin()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;
            isAccountLocked = false;

            var response = await AuthService.Login(loginRequest);
            
            if (response.Success)
            {
                // Guardar información de usuario en el localStorage o servicio de estado
                // Redirigir al dashboard o página principal según el tipo de usuario
                NavigationManager.NavigateTo("/dashboard");
            }            else
            {
                errorMessage = response.Message ?? "Error al iniciar sesión. Verifica tus credenciales.";
                
                // Usar la propiedad IsAccountLocked del response en lugar de detectar por texto
                isAccountLocked = response.IsAccountLocked;
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message ?? "Error desconocido al procesar la solicitud.";
            isAccountLocked = false;
        }
        finally
        {
            isLoading = false;
        }
    }

    private bool IsAccountLockedMessage(string message)
    {
        if (string.IsNullOrEmpty(message)) return false;
        
        return message.Contains("cuenta está bloqueada", StringComparison.OrdinalIgnoreCase) ||
               message.Contains("account is locked", StringComparison.OrdinalIgnoreCase) ||
               message.Contains("bloqueada por intentos", StringComparison.OrdinalIgnoreCase);
    }

    private string GetAlertClass()
    {
        if (isAccountLocked)
            return "alert alert-warning";
        
        return "alert alert-danger";
    }

    private string GetAlertIcon()
    {
        if (isAccountLocked)
            return "fas fa-lock";
        
        return "fas fa-exclamation-circle";
    }
}
