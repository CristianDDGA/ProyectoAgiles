@page "/forgot-password"
@using Microsoft.AspNetCore.Components.Web
@using proyectoAgiles.Services
@layout proyectoAgiles.Layout.AuthLayout
@inject AuthService AuthService
@inject NavigationManager NavigationManager

<PageTitle>Recuperar Contraseña - UTA</PageTitle>

<div class="auth-page">
    <!-- Botón de volver al login -->
    <a href="/login" class="back-to-home-btn">
        <i class="fas fa-arrow-left"></i>
        Volver al Login
    </a>
    
    <div class="auth-container">
        <div class="auth-card">
            <!-- Logo UTA -->
            <div class="auth-logo">
                <img src="images/uta-logo.png" alt="Universidad Técnica de Ambato" class="logo-uta">
                <h2 class="auth-title">Recuperar Contraseña</h2>
                <p class="auth-subtitle">Universidad Técnica de Ambato</p>
            </div>

            @if (!emailSent)
            {
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger">
                        <i class="fas fa-exclamation-circle"></i>
                        @errorMessage
                    </div>
                }

                <!-- Formulario de recuperación -->
                <EditForm Model="forgotPasswordRequest" OnValidSubmit="HandleForgotPassword" class="auth-form">
                    <DataAnnotationsValidator />
                    
                    <div class="form-group">
                        <label for="email" class="form-label">
                            <i class="fas fa-envelope"></i>
                            Correo Electrónico
                        </label>
                        <InputText id="email" class="form-control" placeholder="Ingresa tu correo registrado" 
                                   @bind-Value="forgotPasswordRequest.Email" />
                        <ValidationMessage For="@(() => forgotPasswordRequest.Email)" class="text-danger" />
                        <small class="form-text">Te enviaremos un enlace para restablecer tu contraseña</small>
                    </div>

                    <button type="submit" class="btn btn-primary btn-recover" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm mr-2" role="status" aria-hidden="true"></span>
                            <span>Enviando...</span>
                        }
                        else
                        {
                            <i class="fas fa-paper-plane"></i>
                            <span>Enviar Enlace de Recuperación</span>
                        }
                    </button>
                </EditForm>

                <!-- Enlaces adicionales -->
                <div class="auth-links">
                    <p>¿Recordaste tu contraseña? <a href="/login" class="login-link">Iniciar Sesión</a></p>
                    <p>¿No tienes cuenta? <a href="/register" class="register-link">Regístrate aquí</a></p>
                </div>
            }
            else
            {
                <!-- Mensaje de confirmación -->                <div class="success-message-container">
                    <div class="success-icon">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <h3 class="success-title">¡Solicitud enviada!</h3>
                    <p class="success-text">
                        Te hemos enviado un enlace para restablecer tu contraseña.<br>
                        Por favor revisa tu correo electrónico y sigue las instrucciones.<br>
                        <span class="text-muted">Si no lo encuentras, revisa la carpeta de spam.</span>
                    </p>
                    <div class="success-actions">
                        <a href="/login" class="btn btn-primary">
                            <i class="fas fa-sign-in-alt"></i>
                            Volver al Login
                        </a>
                        <button type="button" class="btn btn-outline-secondary" @onclick="ResetForm">
                            <i class="fas fa-redo"></i>
                            Enviar Otro Enlace
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
    
    <!-- Background decorativo -->
    <div class="auth-background">
        <div class="bg-shape shape-1"></div>
        <div class="bg-shape shape-2"></div>
        <div class="bg-shape shape-3"></div>
    </div>
</div>

@code {
    private ForgotPasswordRequest forgotPasswordRequest = new();
    private bool isLoading = false;
    private bool emailSent = false;
    private string errorMessage = string.Empty;

    private async Task HandleForgotPassword()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;

            var response = await AuthService.ForgotPasswordAsync(forgotPasswordRequest.Email);
            
            if (response.Success)
            {
                emailSent = true;
            }
            else
            {
                errorMessage = response.Message ?? "Error al procesar la solicitud.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ResetForm()
    {
        emailSent = false;
        forgotPasswordRequest = new();
        errorMessage = string.Empty;
    }

    public class ForgotPasswordRequest
    {
        [Required(ErrorMessage = "El email es requerido")]
        [EmailAddress(ErrorMessage = "El formato del email no es válido")]
        public string Email { get; set; } = string.Empty;
    }
}
